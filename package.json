{
  "name": "totallynotdavid-portfolio",
  "type": "module",
  "private": "true",
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "biome ci .",
    "lint:docs": "oxfmt --check '**/*.{md,yml,yaml}'",
    "fix": "biome check --write . && oxfmt '**/*.{md,yml,yaml}'",
    "check": "bun run lint && bun run typecheck && bun run lint:docs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.4",
    "@astrojs/mdx": "8.1.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.4.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@biomejs/biome": "2.5.15",
    "oxfmt": "0.74.0",
    "typescript": "6.0.3"
  }
}
