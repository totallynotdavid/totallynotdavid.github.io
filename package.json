{
  "name": "totallynotdavid-portfolio",
  "type": "module",
  "private": "true",
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "biome format && biome check --write . && bunx prettier --print-width 80 --prose-wrap always --write \"**/*.{md,yml}\"",
    "format:check": "biome ci . && bunx prettier --print-width 80 --prose-wrap always --check \"**/*.{md,yml}\""
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.3",
    "@astrojs/mdx": "8.0.3",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.3.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.5.15",
    "typescript": "6.0.3"
  }
}
