---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import { DEFAULT_LANGUAGE } from '@/config/site';
import { getAlternates } from '@/lib/alternates';

const { path, languages } = await getAlternates(Astro.url.pathname);

const hreflangLinks = languages.map((lang) => ({
  lang,
  href: getAbsoluteLocaleUrl(lang, path),
}));

const defaultLangHref = getAbsoluteLocaleUrl(
  languages.includes(DEFAULT_LANGUAGE) ? DEFAULT_LANGUAGE : languages[0],
  path,
);
---

{
  hreflangLinks.map(({ lang, href }) => (
    <link rel='alternate' hreflang={lang} href={href} />
  ))
}

<link rel='alternate' hreflang='x-default' href={defaultLangHref} />
