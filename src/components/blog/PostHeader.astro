---
interface Props {
  title: string;
  pubDate?: Date;
  showLastModified?: boolean;
}

const { title, pubDate, showLastModified = false } = Astro.props;

// Without a publication date, "Updated" shows the build date.
const dateToDisplay = pubDate ?? (showLastModified ? new Date() : undefined);

function formatDate(d: Date): string {
  const month = d.toLocaleString('en-US', { month: 'long' });
  return `${d.getDate()} ${month}, ${d.getFullYear()}`;
}
---

{
  dateToDisplay && (
    <header class='mb-1 flex flex-col gap-1'>
      <h1 class='font-medium'>{title}</h1>
      <time datetime={dateToDisplay.toISOString()}>
        {showLastModified ? 'Updated ' : ''}
        {formatDate(dateToDisplay)}
      </time>
    </header>
  )
}
